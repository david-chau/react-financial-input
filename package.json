{
  "name": "react-financial-input",
  "version": "0.5.1",
  "description": "Zero-dependency React financial input that formats as you type and handles desktop, iOS and Android input events.",
  "keywords": [
    "react",
    "react-component",
    "financial",
    "currency",
    "money",
    "input",
    "formatting",
    "mobile",
    "ios",
    "android",
    "shortcuts",
    "headless"
  ],
  "author": "david-chau",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-chau/react-financial-input.git"
  },
  "homepage": "https://david-chau.github.io/react-financial-input/",
  "bugs": {
    "url": "https://github.com/david-chau/react-financial-input/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p ./tsconfig-build.json",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "record-demos": "./scripts/record-demos.sh",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.5",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
